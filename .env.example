# Hefesto - exemplo de configuração
# Copie para .env somente na máquina de execução.
# Nunca versione o .env real.

NODE_ENV=production
PORT=3000

# Fuso horário operacional usado para contadores diários
APP_TIME_ZONE=America/Sao_Paulo

# Modo: hub ou edge
APP_MODE=hub

# Autenticação administrativa
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_USE_A_STRONG_PASSWORD

# Hub: segredo usado para autenticar sincronização das filiais
HUB_SYNC_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET

# Atualização via Git
# Habilite somente em um clone Git configurado e após validar as atualizações.
AUTO_UPDATE_ENABLED=false
GIT_UPDATE_BRANCH=main

# Configurações de Edge (somente em filiais)
HUB_URL=http://SEU-SERVIDOR-HEFESTO
HUB_TOKEN=CHANGE_ME_USE_THE_SAME_SYNC_SECRET
EDGE_UNIT_NAME=FILIAL_EXEMPLO
EDGE_UNIT_ID=
EDGE_SYNC_INTERVAL_SEC=300
EDGE_BOOTSTRAP_ON_INIT=true
